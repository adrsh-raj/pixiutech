# Django application
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Fresh PostgreSQL database only
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/NEW_DATABASE_NAME
DJANGO_EXPECTED_DATABASE_NAME=NEW_DATABASE_NAME
DJANGO_DB_SSLMODE=require
DJANGO_DB_CONN_MAX_AGE=60

# Browser/API origins — keep these environment-specific; do not use * in production.
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173

# JWT session policy
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
DJANGO_LOGIN_RATE=10/min
DJANGO_UPLOAD_RATE=30/hour
DJANGO_TRAINER_MATERIAL_UPLOAD_RATE=30/hour
DJANGO_CAREER_APPLY_RATE=5/hour
DJANGO_PUBLIC_ENQUIRY_RATE=10/hour

# Upload policy
SECURE_UPLOAD_MAX_MB=20
CAREER_CV_MAX_MB=2
FILE_UPLOAD_MAX_MEMORY_MB=5

# ClamAV — required in production. Local development may use false/false only when no scanner is available.
CLAMAV_ENABLED=True
CLAMAV_REQUIRED=True
CLAMAV_HOST=127.0.0.1
# Production Render deployments should use the private service host:port instead.
CLAMAV_HOSTPORT=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=30
CLAMAV_RETRY_ATTEMPTS=3
CLAMAV_RETRY_BACKOFF_SECONDS=1
CLAMAV_CHUNK_SIZE=1048576

# One-time/controlled admin bootstrap. Never commit actual values.
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=

# Cloudflare Turnstile — secret key is backend-only and must never be committed.
CLOUDFLARE_TURNSTILE_SECRET_KEY=
CLOUDFLARE_TURNSTILE_ENABLED=True

# Production security
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_HSTS_SECONDS=31536000

# Production security controls
DJANGO_ADMIN_ENABLED=False
# Required only when the Django admin is deliberately enabled in production.
# Must be a non-default path such as a randomly chosen internal route.
DJANGO_ADMIN_PATH=
DJANGO_PORTAL_IDLE_TIMEOUT_SECONDS=600
DJANGO_LOGIN_MAX_FAILED_ATTEMPTS=5
DJANGO_LOGIN_LOCKOUT_MINUTES=15
DJANGO_PASSWORD_RESET_TIMEOUT=3600
DJANGO_PASSWORD_RESET_RATE=10/hour
DJANGO_STUDENT_PASSWORD_RESET_RATE=20/hour
DJANGO_CSRF_TOKEN_RATE=30/hour
