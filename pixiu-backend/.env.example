DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/NEW_DATABASE_NAME
# Set this to the exact NEW database name before deployment.
# Django will refuse to start if DATABASE_URL points somewhere else.
DJANGO_EXPECTED_DATABASE_NAME=NEW_DATABASE_NAME
DJANGO_DB_SSLMODE=require
DJANGO_DB_CONN_MAX_AGE=60
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_HSTS_SECONDS=31536000
