DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=10000
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
CORS_ORIGINS=https://portal.pixiutech.com,https://pixiutech.com,https://www.pixiutech.com

# Optional first-access admin bootstrap. Never commit real values.
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-strong-12-character-or-longer-password
# Set true only for deliberate admin password recovery, then remove/disable it.
ADMIN_BOOTSTRAP_FORCE=false
