{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pixiutech.com/schemas/ai-copilot/record-v1.json",
  "title": "Pixiu AI Copilot Phase 2 Canonical Record Schema",
  "description": "Standardized record envelope for training and evaluation corpus in Pixiu CyberLab AI Copilot Phase 2",
  "type": "object",
  "required": [
    "record_id",
    "record_schema_version",
    "task_type",
    "project_family_id",
    "source",
    "permission",
    "context",
    "instruction",
    "target",
    "validation",
    "capabilities",
    "review",
    "variant",
    "hashes",
    "limitations"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "pattern": "^pxai2-[a-z0-9\\-_]+$"
    },
    "record_schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "task_type": {
      "type": "string",
      "enum": [
        "request_to_circuit",
        "fault_repair",
        "diagnosis_explanation",
        "blockly_code"
      ]
    },
    "project_family_id": {
      "type": "string",
      "pattern": "^family-[a-z0-9\\-_]+$"
    },
    "source": {
      "type": "object",
      "required": ["source_type", "source_path", "source_id", "source_revision"],
      "properties": {
        "source_type": {
          "type": "string",
          "enum": [
            "pixiu_template",
            "pixiu_mission",
            "pixiu_diagnostic",
            "synthetic_mutation"
          ]
        },
        "source_path": { "type": "string" },
        "source_id": { "type": "string" },
        "source_revision": { "type": "string" }
      }
    },
    "permission": {
      "type": "object",
      "required": ["status", "review_status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["internal_owned", "external_reviewed"]
        },
        "review_status": {
          "type": "string",
          "enum": ["approved", "in_review", "rejected"]
        }
      }
    },
    "context": {
      "type": "object",
      "required": ["target_board"],
      "properties": {
        "target_board": {
          "type": ["string", "null"]
        },
        "grade_band": {
          "type": ["integer", "null"]
        }
      }
    },
    "instruction": {
      "type": "object",
      "required": ["text"],
      "properties": {
        "text": { "type": "string", "minLength": 3 }
      }
    },
    "target": {
      "type": "object",
      "properties": {
        "circuit": {
          "type": "object",
          "properties": {
            "parts": { "type": "array" },
            "wires": { "type": "array" }
          }
        },
        "corrected_circuit": {
          "type": "object",
          "properties": {
            "parts": { "type": "array" },
            "wires": { "type": "array" }
          }
        },
        "explanation": { "type": ["string", "null"] },
        "code": { "type": ["string", "null"] }
      }
    },
    "fault": {
      "type": "object",
      "required": ["mutation_id", "input_circuit", "expected_validator_status", "expected_rule_ids"],
      "properties": {
        "mutation_id": { "type": "string" },
        "input_circuit": {
          "type": "object",
          "required": ["parts", "wires"],
          "properties": {
            "parts": { "type": "array" },
            "wires": { "type": "array" }
          }
        },
        "expected_validator_status": {
          "type": "string",
          "enum": ["warning_or_reject", "reject", "warning"]
        },
        "expected_rule_ids": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "validation": {
      "type": "object",
      "required": ["status", "validator_version", "errors", "warnings"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["pass", "warning", "reject"]
        },
        "validator_version": { "type": "string" },
        "errors": {
          "type": "array",
          "items": { "type": "string" }
        },
        "warnings": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "required": ["simulation", "compile"],
      "properties": {
        "simulation": {
          "type": "string",
          "enum": ["supported", "partial", "unsupported", "not_tested"]
        },
        "compile": {
          "type": "string",
          "enum": ["supported", "partial", "unsupported", "not_tested"]
        }
      }
    },
    "review": {
      "type": "object",
      "required": ["status", "reviewer", "reviewed_at"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["approved", "draft", "in_review", "rejected"]
        },
        "reviewer": { "type": "string" },
        "reviewed_at": { "type": "string" }
      }
    },
    "variant": {
      "type": "object",
      "required": ["kind", "parent_record_id"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "canonical",
            "paraphrase",
            "typo",
            "colloquial",
            "bilingual",
            "fault",
            "repair"
          ]
        },
        "parent_record_id": { "type": ["string", "null"] }
      }
    },
    "hashes": {
      "type": "object",
      "required": ["source_hash", "topology_hash", "content_hash"],
      "properties": {
        "source_hash": { "type": "string" },
        "topology_hash": { "type": "string" },
        "content_hash": { "type": "string" }
      }
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
