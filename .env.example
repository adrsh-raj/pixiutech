# Public website configuration
VITE_LMS_URL=https://portal.pixiutech.com

# Public certificate verification API. Point this at the Django /api/v1 root.
VITE_API_URL=https://pixiu-django-api.onrender.com/api/v1

# Server-side enquiry delivery used by /api/enquiry (never expose as VITE_*).
# Example: https://formspree.io/f/<form-id>
ENQUIRY_DELIVERY_ENDPOINT=https://formspree.io/f/<form-id>
